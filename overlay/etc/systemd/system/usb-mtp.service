[Unit]
Description=USB MTP Gadget (expose folder to PC as Android-style MTP device)
After=local-fs.target systemd-modules-load.service
Conflicts=usb-massstorage.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-mtp-setup
ExecStop=/usr/local/bin/usb-mtp-stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
